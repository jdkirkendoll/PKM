{
  "manifest_version": 3,
  "name": "PDF Page Library",
  "version": "1.1.0",
  "description": "Save the current page (or several open tabs at once) as a PDF into an organized local library, with duplicate detection.",
  "permissions": ["debugger", "downloads", "storage", "activeTab", "tabs", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save page to PDF library"
  }
}
